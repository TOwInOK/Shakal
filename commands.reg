Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.png\shell\ConvertToWebP]
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.png\shell\ConvertToWebP\shell\01_q95\command]
@="powershell.exe -NoProfile -WindowStyle Hidden -Command \"$f='%1'; $o=[IO.Path]::ChangeExtension($f,'.webp'); ffmpeg -y -hide_banner -loglevel error -i $f -quality 95 $o\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.png\shell\ConvertToWebP\shell\02_q80\command]
