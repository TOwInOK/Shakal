[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.webp\shell\ConvertToPNG\command]
@="powershell.exe -NoProfile -WindowStyle Hidden -Command \"$f='%1'; $o=[IO.Path]::ChangeExtension($f,'.png'); ffmpeg -y -hide_banner -loglevel error -i $f $o\""
